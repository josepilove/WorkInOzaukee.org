---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  DAYS,
  DAY_LABEL,
  formatRange,
  formatDate,
  formatDateShort,
  gridState,
  daysSince,
  isStale,
  visitsFor,
  duration,
  timeBucket,
  seasonOf,
  SOURCE_LABEL,
  sourceTrust,
} from '../../lib/hours';
import {
  QUALITIES,
  CONTINUA,
  PROFILES,
  profileScore,
  formatScore,
  hasAnyScore,
  verdictFor,
  bestProfile,
  continuumLabel,
  continuumPercent,
} from '../../lib/rubric';
import { venueJsonLd, breadcrumbJsonLd, hoursSentence } from '../../lib/seo';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  return venues.map((venue) => ({ params: { slug: venue.id }, props: { venue } }));
}

const { venue } = Astro.props;
const { Content } = await render(venue);

const allVisits = await getCollection('visits');
const visits = visitsFor(venue.id, allVisits);
const now = new Date();
const stale = isStale(venue, now);
const trust = sourceTrust(venue.data.hours_source);

const testedDays = DAYS.filter((d) => gridState(venue, d, allVisits) === 'tested');

const scores = venue.data.scores ?? {};
const scored = hasAnyScore(scores);
const best = scored ? bestProfile(scores) : null;

const roommate = venue.data.shares_space_with
  ? (await getCollection('venues')).find((v) => v.id === venue.data.shares_space_with)
  : undefined;

const summary = hoursSentence(venue);
const description = `${venue.data.name} in Port Washington, Wisconsin as a place to work. ${summary} Hours ${SOURCE_LABEL[venue.data.hours_source]}, last confirmed ${formatDateShort(venue.data.hours_checked)}.`;
---

<Layout
  title={`${venue.data.name} — working from it, hours and what it's like`}
  description={description.slice(0, 300)}
  modified={venue.data.hours_checked}
  jsonLd={[
    venueJsonLd(venue),
    breadcrumbJsonLd([
      { name: 'Where to go, today', path: '/' },
      { name: 'Port Washington', path: '/port-washington' },
      { name: venue.data.name, path: `/venues/${venue.id}` },
    ]),
  ]}
>
  <h1>{venue.data.name}</h1>
  <p class="lede">
    {venue.data.type === 'cafe' ? 'Cafe' : venue.data.type === 'library' ? 'Library' : venue.data.type}
    {venue.data.address && <> · {venue.data.address}</>}
  </p>

  {best && (
    <p class="best">
      Best for <b>{best.profile.label.toLowerCase()}</b>{' '}
      <span class="meta">— {verdictFor(best.score)}</span>
    </p>
  )}

  <ul class="attrs">
    <li><b>Cost</b> {venue.data.cost.replace('-', ' ')}</li>
    <li><b>Calls</b> {venue.data.calls_ok === 'rooms' ? 'bookable rooms' : venue.data.calls_ok}</li>
    <li><b>{venue.data.indoor ? 'Indoor' : 'Outdoor'}</b></li>
    <li><b>Season</b> {venue.data.seasons.length === 4 ? 'year-round' : venue.data.seasons.join(', ')}</li>
    {venue.data.url && <li><a href={venue.data.url}>website</a></li>}
    {venue.data.phone && <li>{venue.data.phone}</li>}
  </ul>

  {
    roommate && (
      <p class="card">
        Shares this address with <a href={`/venues/${roommate.id}`}>{roommate.data.name}</a>,
        which has the other half of the clock. Between them the room is open far more of
        the week than either one alone.
      </p>
    )
  }

  <h2>Hours</h2>
  <p>{summary}</p>
  <p>
    <span class={`prov ${trust}`}>{SOURCE_LABEL[venue.data.hours_source]}</span>
    <span class="meta">
      · last checked {formatDateShort(venue.data.hours_checked)}
      ({daysSince(venue.data.hours_checked, now)} days ago){stale && (
        <> — old enough that I'd call ahead</>
      )}
    </span>
  </p>

  <div class="grid-wrap">
    <table class="grid">
      <thead>
        <tr>{DAYS.map((d) => <th scope="col" class="day">{DAY_LABEL[d]}</th>)}</tr>
      </thead>
      <tbody>
        <tr>
          {
            DAYS.map((day) => {
              const state = gridState(venue, day, allVisits);
              return (
                <td>
                  <span class={`cell ${state}`}>
                    <span class="time">{formatRange(venue.data.hours[day])}</span>
                    {state === 'tested' && <span class="tag">worked here</span>}
                  </span>
                </td>
              );
            })
          }
        </tr>
      </tbody>
    </table>
  </div>

  {
    venue.data.exceptions.length > 0 && (
      <>
        <h3>Known exceptions</h3>
        <ul class="stack">
          {venue.data.exceptions.map((e) => (
            <li><b>{formatDateShort(e.date)}</b> — {e.status}. {e.reason}</li>
          ))}
        </ul>
        <p class="note">Best-effort only. One-off closures are never guaranteed complete.</p>
      </>
    )
  }

  <div class="prose"><Content /></div>

  {
    scored && (
      <>
        <h2>What it's like</h2>
        <p class="note">
          Scored against <a href="/scoring">the same rubric</a> every place here gets
          {venue.data.scores_updated && (
            <> · last revisited {formatDateShort(venue.data.scores_updated)}</>
          )}
        </p>

        <ul class="continua">
          {CONTINUA.map((def) =>
            typeof scores[def.key] === 'number' ? (
              <li>
                <div class="cont-head">
                  <b>{def.label}</b>
                  <span class="cont-value">{continuumLabel(def, scores[def.key]!)}</span>
                </div>
                <div class="cont-track">
                  <span class="cont-dot" style={`left:${continuumPercent(scores[def.key]!)}%`} />
                </div>
                <div class="cont-poles">
                  <span>{def.low}</span>
                  <span>{def.high}</span>
                </div>
              </li>
            ) : null,
          )}
        </ul>

        <ul class="attrs">
          {QUALITIES.map((dim) =>
            typeof scores[dim.key] === 'number' ? (
              <li><b>{dim.label}</b> {scores[dim.key]}/5</li>
            ) : null,
          )}
        </ul>

        <h3>Depending on the kind of day</h3>
        <ul class="stack">
          {PROFILES.map((p) => {
            const s = profileScore(scores, p);
            return (
              <li>
                <b>{p.label}</b>{' '}
                {s === null ? (
                  <span class="meta">not enough scored to say</span>
                ) : (
                  <>{formatScore(s)}/5 <span class="meta">— {verdictFor(s)}</span></>
                )}
                <div class="meta">{p.blurb}</div>
              </li>
            );
          })}
        </ul>
      </>
    )
  }

  <h2>Visits</h2>
  {
    visits.length === 0 ? (
      <p class="note">
        No writeup yet — it's on my list. If you've worked here,{' '}
        <a href="mailto:hello@workinozaukee.org">tell me what it's like</a>.
      </p>
    ) : (
      <>
        <p class="note">Written up on {testedDays.map((d) => DAY_LABEL[d]).join(', ')}.</p>
        <ul class="stack">
          {visits.map((v) => (
            <li>
              <a href={`/log/${v.id}`}>{formatDate(v.data.date)}</a>
              {v.data.verdict && <> — {v.data.verdict}</>}
              <ul class="attrs">
                {v.data.arrived && (
                  <li>
                    <b>{timeBucket(v.data.arrived)}</b>
                    {duration(v.data.arrived, v.data.left) && <> · {duration(v.data.arrived, v.data.left)}</>}
                  </li>
                )}
                <li><b>{seasonOf(v.data.date)}</b></li>
                {v.data.zone && <li>{v.data.zone}</li>}
                {v.data.wifi && <li><b>wifi</b> {v.data.wifi}</li>}
                {v.data.outlets && <li><b>outlets</b> {v.data.outlets}</li>}
                {v.data.noise !== undefined && <li><b>noise</b> {v.data.noise}/5</li>}
                {v.data.laptops !== undefined && <li><b>{v.data.laptops}</b> other laptops</li>}
              </ul>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <p><a href="/port-washington">← Everywhere in Port Washington</a></p>
</Layout>
