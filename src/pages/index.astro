---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {
  DAYS,
  DAY_LABEL,
  formatRange,
  formatDateShort,
  gridState,
  sortVisits,
} from '../lib/hours';

const venues = (await getCollection('venues')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const visits = sortVisits(await getCollection('visits'));

// Minimal payload for the client-side "open right now" panel. A static site
// can't compute this at build time — the answer depends on when you look.
const openNowData = venues.map((v) => ({
  slug: v.id,
  name: v.data.name,
  hours: v.data.hours,
  exceptions: v.data.exceptions,
}));

const callRooms = venues.filter((v) => v.data.calls_ok === 'rooms');
---

<Layout title="Work in Ozaukee — where to work in Port Washington">
  <h1>Where to work in Port Washington</h1>
  <p class="lede">
    Cafes, the library, lobbies, picnic tables — the places in town where you can sit
    down and get through an afternoon. Opening hours below, checked by hand and stamped
    with the date so you can see how much to trust them.
  </p>

  <section>
    <h2>Open right now</h2>
    <div id="open-now"></div>
    <noscript>
      <p class="note">Needs JavaScript. The week's hours are below either way.</p>
    </noscript>
  </section>

  <h2>Hours this week</h2>

  <div class="grid-wrap">
    <table class="grid">
      <thead>
        <tr>
          <th>&nbsp;</th>
          {DAYS.map((d) => <th class="day">{DAY_LABEL[d]}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          venues.map((venue) => (
            <tr>
              <th><a href={`/venues/${venue.id}`}>{venue.data.name}</a></th>
              {DAYS.map((day) => {
                const state = gridState(venue, day, visits);
                return (
                  <td>
                    <a class={`cell ${state}`} href={`/venues/${venue.id}`}>
                      <span class="time">{formatRange(venue.data.hours[day])}</span>
                      {state === 'tested' && <span class="tag">worked here</span>}
                    </a>
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ul class="legend">
    <li><span class="swatch tested"></span> I've worked here on this day — there's a writeup</li>
    <li><span class="swatch untested"></span> open</li>
    <li><span class="swatch closed"></span> closed</li>
  </ul>

  {
    callRooms.length > 0 && (
      <>
        <h2>If you have calls</h2>
        <p>
          The hardest thing to find in a small town is a door that closes.{' '}
          {callRooms.map((v, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/venues/${v.id}`}>{v.data.name}</a>
            </>
          ))}{' '}
          {callRooms.length === 1 ? 'has bookable rooms' : 'have bookable rooms'} — free,
          and usually available on short notice.
        </p>
      </>
    )
  }

  {
    visits.length > 0 && (
      <>
        <h2>Recent writeups</h2>
        <ul class="stack">
          {visits.slice(0, 5).map((visit) => {
            const venue = venues.find((v) => v.id === visit.data.venue.id);
            return (
              <li>
                <a href={`/log/${visit.id}`}>{venue?.data.name ?? visit.data.venue.id}</a>
                {visit.data.verdict && <> — {visit.data.verdict}</>}
                <div class="meta">{formatDateShort(visit.data.date)}</div>
              </li>
            );
          })}
        </ul>
        <p><a href="/log">Everything →</a></p>
      </>
    )
  }

  <h2>Know a spot?</h2>
  <p>
    This list is short on purpose — everything on it is somewhere I've actually sat and
    worked. If there's somewhere good I've missed, or you've found a corner of one of
    these places that works better than the one I picked,{' '}
    <a href="mailto:hello@workinozaukee.org">tell me</a> and I'll go try it.
  </p>
  <p class="note">
    Same if the hours here are wrong. That happens, and I'd rather hear it from you than
    have someone drive downtown for nothing.
  </p>

  <script type="application/json" id="venue-data" set:html={JSON.stringify(openNowData)} />

  <script is:inline>
    (function () {
      var el = document.getElementById('open-now');
      var raw = document.getElementById('venue-data');
      if (!el || !raw) return;
      var venues = JSON.parse(raw.textContent || '[]');

      var KEYS = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];

      function mins(t) {
        var p = t.split(':');
        return +p[0] * 60 + +p[1];
      }
      function fmt(t) {
        var p = t.split(':');
        var h = +p[0];
        var m = +p[1];
        var period = h < 12 ? 'am' : 'pm';
        var hour = h % 12 === 0 ? 12 : h % 12;
        return m === 0 ? hour + period : hour + ':' + p[1] + period;
      }
      function today(d) {
        function p(n) { return String(n).padStart(2, '0'); }
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
      }

      function render() {
        var now = new Date();
        var stamp = today(now);
        var nowMins = now.getHours() * 60 + now.getMinutes();
        var open = [];

        venues.forEach(function (v) {
          var exc = (v.exceptions || []).filter(function (e) { return e.date === stamp; })[0];
          if (exc && exc.status === 'closed') return;
          var range = v.hours[KEYS[now.getDay()]];
          if (!range) return;
          if (nowMins < mins(range[0]) || nowMins >= mins(range[1])) return;
          open.push({
            name: v.name,
            slug: v.slug,
            until: range[1],
            degraded: exc && exc.status === 'degraded' ? exc.reason : null,
          });
        });

        if (!open.length) {
          el.innerHTML =
            '<p class="note">Nothing on the list is open right now. ' +
            'The library is usually the last to close.</p>';
          return;
        }

        el.innerHTML =
          '<ul class="stack">' +
          open
            .map(function (o) {
              return (
                '<li><a href="/venues/' + o.slug + '">' + o.name + '</a> ' +
                '<span class="status ' + (o.degraded ? 'degraded' : 'open') + '">' +
                (o.degraded ? 'open but rough' : 'open') + '</span> ' +
                '<span class="meta">until ' + fmt(o.until) + '</span>' +
                (o.degraded ? '<div class="meta">' + o.degraded + '</div>' : '') +
                '</li>'
              );
            })
            .join('') +
          '</ul>';
      }

      render();
      setInterval(render, 60000);
    })();
  </script>
</Layout>
